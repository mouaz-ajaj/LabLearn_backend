{
  "info": {
    "_postman_id": "b4299532-a374-4c59-a495-lablearn-phase1",
    "name": "LabLearn Phase 1 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "reset_token", "value": "" }
  ],
  "item": [
    {
      "name": "Register Regular User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Demo Regular\",\n  \"email\": \"regular@example.com\",\n  \"password\": \"StrongPassword123!\",\n  \"password_confirmation\": \"StrongPassword123!\",\n  \"role\": \"regular\"\n}" },
        "url": "{{base_url}}/auth/register"
      },
      "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.data?.token) pm.collectionVariables.set('token', json.data.token);"] } }]
    },
    {
      "name": "Register Student",
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Demo Student\",\n  \"email\": \"student@example.com\",\n  \"password\": \"StrongPassword123!\",\n  \"password_confirmation\": \"StrongPassword123!\",\n  \"role\": \"student\",\n  \"study_year\": \"4\"\n}" },
        "url": "{{base_url}}/auth/register"
      },
      "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.data?.token) pm.collectionVariables.set('token', json.data.token);"] } }]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"StrongPassword123!\"\n}" },
        "url": "{{base_url}}/auth/login"
      },
      "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.data?.token) pm.collectionVariables.set('token', json.data.token);"] } }]
    },
    {
      "name": "Auth Me",
      "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{base_url}}/auth/me" }
    },
    {
      "name": "Logout",
      "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{base_url}}/auth/logout" }
    },
    {
      "name": "Forgot Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"student@example.com\"\n}" },
        "url": "{{base_url}}/auth/forgot-password"
      }
    },
    {
      "name": "Reset Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"student@example.com\",\n  \"token\": \"{{reset_token}}\",\n  \"password\": \"NewStrongPassword123!\",\n  \"password_confirmation\": \"NewStrongPassword123!\"\n}" },
        "url": "{{base_url}}/auth/reset-password"
      }
    },
    {
      "name": "Get Profile",
      "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{base_url}}/users/me" }
    },
    {
      "name": "Update Profile",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Name\",\n  \"study_year\": \"5\"\n}" },
        "url": "{{base_url}}/users/me"
      }
    },
    {
      "name": "Delete Account",
      "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{base_url}}/users/me" }
    }
  ]
}
